/data/
/datasets/
*.csv
*.tsv
*.json.gz
*.h5
*.dcm
*.nii
*.nii.gz

# Generated outputs
results/*
!results/.gitkeep
outputs/
*.out

# Logs
*.log
logs/

# Model checkpoints and weights
*.ckpt
*.pt
*.pth
*.bin
*.safetensors
checkpoints/
weights/

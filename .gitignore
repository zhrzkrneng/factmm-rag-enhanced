# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Notebook checkpoints
.ipynb_checkpoints/

# IDE files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Environment and secret files
.env
.env.*
*.pem
*.key
secrets/
credentials/

# Datasets (root-level only — must not shadow reference/original_repository's
